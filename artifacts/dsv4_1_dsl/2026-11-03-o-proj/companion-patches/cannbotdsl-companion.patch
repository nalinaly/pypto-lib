 import cannbotdsl as cb
+from cannbotdsl.buffer import Buffer
 import pytest


@@ -50,6 +51,25 @@ class Adder:
             out[i] = x[i] + self.increment


+@cb.kernel
+def interleave_float32(x: cb.Tensor, out: cb.Tensor):
+    source = Buffer(cb.MemLoc.UB, cb.dtypes.float32, cb.make_layout((128,)))
+    target = Buffer(cb.MemLoc.UB, cb.dtypes.float32, cb.make_layout((128,)))
+    cb.mem_copy(source, x)
+    with cb.vf():
+        first = cb.reg.vload(source, 0)
+        second = cb.reg.vload(source, 64)
+        cb.reg.vstore_interleave(target, 0, first, second)
+    cb.mem_copy(out, target)
+
+
+def test_float32_interleaved_store_uses_bitwise_integer_overload():
+    spec = cb.TensorSpec((128,), cb.dtypes.float32)
+    exported = cb.export_device(interleave_float32, spec, spec)
+    store = next(line for line in exported.source.splitlines() if "asc_storealign_intlv(" in line)
+    assert "uint32_t" in store
+
+
